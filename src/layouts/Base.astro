---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import profile from "../content/personal-info/profile.json";

const { title, activePage } = Astro.props;
const googleAnalyticsId = "G-3CG3K6B06G";
const pageDepth = Astro.url.pathname.split("/").filter(Boolean).length;
const rootPath = pageDepth === 0 ? "./" : "../".repeat(pageDepth);
const homePath = rootPath;
const projectsPath = `${rootPath}projects/`;
const insightsPath = `${rootPath}insights/`;
const resumePath = `${rootPath}resume.pdf`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={`${profile.name} — ${profile.currentRole} at ${profile.currentCompany}`}
    />
    <meta property="og:title" content={`${title} · ${profile.name}`} />
    <meta
      property="og:description"
      content={`${profile.currentRole} · ${profile.currentCompany} · ${profile.location}`}
    />
    <title>{title} · {profile.name}</title>
    <link
      rel="icon"
      type="image/png"
      href={`${rootPath}favicon/favicon-96x96.png`}
      sizes="96x96"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${rootPath}favicon/favicon.svg`}
    />
    <link rel="shortcut icon" href={`${rootPath}favicon/favicon.ico`} />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={`${rootPath}favicon/apple-touch-icon.png`}
    />
    <link rel="manifest" href={`${rootPath}favicon/site.webmanifest`} />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <script
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}
    ></script>
    <script define:vars={{ googleAnalyticsId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", googleAnalyticsId);
    </script>
    <script type="text/javascript">
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script", "xn6meuoo1e");
    </script>
    <script
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="23730601-bcce-4ddf-bc59-3b1ca69f6c87"></script>
    <script is:inline>
      // Clean UTM params from URL bar after GA4 captures them
      window.addEventListener("load", () => {
        const url = new URL(window.location.href);
        const hasUtm = [...url.searchParams.keys()].some((k) =>
          k.startsWith("utm_"),
        );

        if (hasUtm) {
          url.searchParams.delete("utm_source");
          url.searchParams.delete("utm_medium");
          url.searchParams.delete("utm_campaign");
          url.searchParams.delete("utm_content");
          url.searchParams.delete("utm_term");
          window.history.replaceState({}, "", url.pathname);
        }
      });
    </script>
  </head>
  <body>
    <div class="page-shell">
      <nav>
        <div class="site-identity">
          <a
            href={homePath}
            class="site-avatar-link"
            aria-label={`${profile.name} home`}
          >
            <img class="site-avatar" src={`${rootPath}profile.png`} alt="" />
          </a>
          <div class="site-text">
            <a href={homePath} class="site-name">{profile.name}</a>
            <p class="site-status">{profile.status}</p>
          </div>
        </div>
        <div class="nav-links">
          <a href={homePath} class={activePage === "home" ? "active" : ""}
            >Home</a
          >
          <a
            href={projectsPath}
            class={activePage === "projects" ? "active" : ""}>Projects</a
          >
          <a
            href={insightsPath}
            class={activePage === "insights" ? "active" : ""}>Insights</a
          >
          <a
            href={resumePath}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Open resume"
            title="Resume">Resume</a
          >
        </div>
      </nav>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-copyright">
          {profile.name}&nbsp; © 2026
        </div>
        <div class="footer-links">
          <a
            href={`mailto:${profile.email}`}
            class="icon-link"
            aria-label="Email"
            title={profile.email}
          >
            <Icon name="email" />
          </a>
          <a
            href={profile.github}
            target="_blank"
            rel="noopener noreferrer"
            class="icon-link"
            aria-label="GitHub"
            title="GitHub"
          >
            <Icon name="github" />
          </a>
          <a
            href={profile.x}
            target="_blank"
            rel="noopener noreferrer"
            class="icon-link"
            aria-label="X"
            title="X"
          >
            <Icon name="x" />
          </a>
          <a
            href={profile.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="icon-link"
            aria-label="LinkedIn"
            title="LinkedIn"
          >
            <Icon name="linkedin" />
          </a>
        </div>
        <p class="footer-note">
          This site uses Google Analytics and Microsoft Clarity for basic
          analytics.
        </p>
      </footer>
    </div>
  </body>
</html>
