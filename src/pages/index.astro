---
import Base from "../layouts/Base.astro";
import profile from "../content/personal-info/profile.json";
import Intro from "../content/home/intro.md";
---

<Base title="Home" activePage="home">
  <!-- Intro -->
  <div class="intro">
    <div class="intro-copy">
      <h1 class="intro-name">{profile.name}</h1>
      <div class="intro-bio">
        <Intro />
      </div>
    </div>
  </div>

  <!-- Experience -->
  <h2>Experience</h2>

  {
    profile.experience.map((exp) => (
      <div class="entry">
        <div class="entry-header">
          <span class="entry-role">{exp.role}</span>
          <span class="entry-period">{exp.period}</span>
        </div>
        <div class="entry-company">
          {exp.company} &nbsp;·&nbsp; {exp.location}
        </div>
        <div class="entry-highlight">{exp.highlight}</div>
        {exp.bullets && (
          <ul class="entry-bullets">
            {exp.bullets.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
      </div>
    ))
  }

  <!-- Education -->
  <h2>Education</h2>

  {
    profile.education.map((edu) => (
      <div class="entry">
        <div class="entry-header">
          <span class="entry-role">{edu.degree}</span>
          <span class="entry-period">{edu.period}</span>
        </div>
        <div class="entry-company">{edu.institution}</div>
        {edu.note && <div class="entry-highlight">{edu.note}</div>}
      </div>
    ))
  }
</Base>
