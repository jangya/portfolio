---
import Base from "../../layouts/Base.astro";

type InsightFrontmatter = {
  title: string;
  date: string;
  category: string;
  description: string;
};

export async function getStaticPaths() {
  const insightModules = import.meta.glob("../../content/insights/*.md", {
    eager: true,
  });

  return Object.entries(insightModules).map(([path, entry]) => {
    const insightEntry = entry as {
      Content: any;
      frontmatter: InsightFrontmatter;
    };

    const slug = path.split("/").pop()?.replace(".md", "");

    return {
      params: { slug },
      props: { entry: insightEntry },
    };
  });
}

const { entry } = Astro.props as {
  entry: { Content: any; frontmatter: InsightFrontmatter };
};
const { Content, frontmatter } = entry;

const formatDate = (date: string) =>
  new Date(`${date}T00:00:00`).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
---

<Base title={frontmatter.title} activePage="insights">
  <article class="article">
    <a class="back-link" href="/insights">← Insights</a>
    <p class="post-date">
      {formatDate(frontmatter.date)} &nbsp;·&nbsp; {frontmatter.category}
    </p>
    <h1>{frontmatter.title}</h1>
    <p class="article-description">{frontmatter.description}</p>
    <Content />
  </article>
</Base>
